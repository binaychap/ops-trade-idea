DRY_RUN=true
MAX_NOTIONAL_USD=250
ALLOW_SHORT_SELLING=false
FORCE_REPROCESS=false

OPTIONOMICS_API_KEY=your-optionomics-api-key
OPTIONOMICS_EMAIL=you@example.com
OPTIONOMICS_API_URL=https://optionomics.ai/api/v1/trade_ideas
OPTIONOMICS_POLL_ENABLED=true
OPTIONOMICS_POLL_INTERVAL_SECONDS=600

WEBULL_APP_KEY=your-webull-app-key
WEBULL_APP_SECRET=your-webull-app-secret
# paper (default) or live. DRY_RUN independently controls order submission.
WEBULL_TRADING_MODE=paper
# Optional: blank selects the host for the mode; mismatches are rejected.
WEBULL_ENDPOINT=

DATABASE_PATH=bot.sqlite3

# Strategy exit percentages (10 means 10%)
BULLISH_PROFIT_PERCENT=10
BULLISH_STOP_LOSS_PERCENT=5
BEARISH_PROFIT_PERCENT=20
BEARISH_STOP_LOSS_PERCENT=10
IRON_CONDOR_PROFIT_PERCENT=10
IRON_CONDOR_STOP_LOSS_PERCENT=5

# Required exact account number for bearish PUT and iron-condor submissions
OPTIONS_MARGIN_ACCOUNT_NUMBER=

# Exact cash account number for the main.py bullish stock path
BULLISH_STOCK_ACCOUNT_NUMBER=

# PUT quote age limit; 1200 allows 15-minute-delayed quotes for sandbox testing.
BEARISH_QUOTE_MAX_AGE_SECONDS=60

# Iron-condor quote age limit; use 1200 for delayed sandbox paper testing.
IRON_CONDOR_QUOTE_MAX_AGE_SECONDS=60

# Bearer token for the iOS trading API (Authorization: Bearer <token>).
# Leave empty to disable /api/trading/* (routes return 503).
IOS_API_KEY=

# Daily 10:00 AM ET market sell of ALL stocks in BULLISH_STOCK_ACCOUNT_NUMBER
# (scheduled_stock_exits not complete + submitted top_bullish_trades).
# Disabled by default; DRY_RUN=true also prevents broker submissions.
# Bullish-runner holdings resolve to BULLISH_STOCK_ACCOUNT_NUMBER.
MORNING_SELL_ENABLED=false
MORNING_SELL_TIME=10:00
MORNING_SELL_TIMEZONE=America/New_York
MORNING_SELL_POLL_SECONDS=60

# Accounts selected by WEBULL_TRADING_MODE. Live requires explicit live values.
WEBULL_PAPER_BULLISH_STOCK_ACCOUNT_NUMBER=
WEBULL_PAPER_TOP_BULLISH_ACCOUNT_NUMBER=
WEBULL_PAPER_OPTIONS_MARGIN_ACCOUNT_NUMBER=
WEBULL_LIVE_BULLISH_STOCK_ACCOUNT_NUMBER=
WEBULL_LIVE_TOP_BULLISH_ACCOUNT_NUMBER=
WEBULL_LIVE_OPTIONS_MARGIN_ACCOUNT_NUMBER=

# Cash amount per live automated bullish stock entry; paper/options unchanged.
WEBULL_LIVE_BULLISH_AMOUNT_USD=100

WEBULL_LIVE_BULLISH_DAILY_LIMIT_USD=100

# 0 disables the separate options cap; set a positive dollar limit to enable.
WEBULL_LIVE_OPTIONS_DAILY_LIMIT_USD=0

# Only live bearish PUTs: false omits the stop leg, keeping the profit leg.
WEBULL_LIVE_BEARISH_STOP_LOSS_ENABLED=true
